# Copy to ignored deploy/api.env on the VM; chmod 600. No desktop camera keys.
DATABASE_URL=
# Optional container path after placing the Tiger CA in deploy/certs/tiger-ca.pem.
DATABASE_CA_FILE=
TRUEIRIS_INGEST_TOKEN=
TRUEIRIS_USER_ID=00000000-0000-4000-8000-000000000001
TRUEIRIS_DEMO_USER_ID=00000000-0000-4000-8000-000000000019
TRUEIRIS_DEMO_MODE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TRUEIRIS_REASONING_PROVIDER=gemini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
TRUEIRIS_VOICE_PROVIDER=elevenlabs
LOG_LEVEL=info
