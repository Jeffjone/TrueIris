# Optional credentials. Camera sensing starts only after a user action.
PRESAGE_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DATABASE_URL=
# Optional PEM CA path for Tiger Data; TLS certificate verification stays enabled.
DATABASE_CA_FILE=
# Shared private desktop/API bearer token (32+ characters); never a VITE_ variable.
TRUEIRIS_INGEST_TOKEN=
# Single-user API identity, bound to the token on the server.
TRUEIRIS_USER_ID=00000000-0000-4000-8000-000000000001

# Desktop main process only; no VITE_ secret variables.
TRUEIRIS_API_URL=http://127.0.0.1:3001
TRUEIRIS_API_HOST=127.0.0.1
TRUEIRIS_API_PORT=3001
TRUEIRIS_DEMO_MODE=false
LOG_LEVEL=info
VULTR_DEPLOYMENT_ENV=local

# presage (default) or mock. Neither starts automatically.
TRUEIRIS_SENSOR_PROVIDER=presage
# Mock scenarios: steady, no_face, low_confidence, lighting, motion, talking,
# network, no_camera, permission_denied. Used only with the mock provider.
TRUEIRIS_MOCK_SENSOR_SCENARIO=steady
